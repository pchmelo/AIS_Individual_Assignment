# =============================================================================
# Environment Variables for Fairness Evaluation
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Never commit .env files to version control!
#
# Usage:
#   python -m cli --env-file .env --data data.csv
#   
# Or set these as system environment variables.
# =============================================================================

# OpenRouter API Key (get free at https://openrouter.ai)
# Required if using openrouter models
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google API Key (get at https://aistudio.google.com/apikey)
# Required if using gemini models
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Hugging Face token for gated models
# HF_TOKEN=hf_your-token-here
